# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=https://gcebatauli.com,https://www.gcebatauli.com,http://localhost:3000,http://127.0.0.1:3000

# Google My Business Configuration
GMB_LOCATION_ID=locations/your-location-id
GMB_SERVICE_ACCOUNT_KEY_PATH=./gmb-service-account.json

# Email Configuration (SMTP with TLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin Gate Passcode (4-digit secret code to access admin login page)
ADMIN_GATE_PASSCODE=1234

# Google reCAPTCHA v3 Keys
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Session Secret (Generate a strong random string for production)
SESSION_SECRET=your-super-secret-random-string-change-this-in-production

# Admin Credentials (Change these for production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password

# Environment
NODE_ENV=production
